{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": { "JSONV_BUILD_TESTS": "ON" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug build with tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release build with tests and LTO",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "JSONV_LTO": "ON" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan and UBSan (clang, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JSONV_SANITIZE": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "tidy",
      "inherits": "base",
      "displayName": "compile_commands.json for clang-tidy (clang, Debug)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JSONV_BUILD_TESTS": "OFF",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer targets (clang, RelWithDebInfo)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "JSONV_BUILD_TESTS": "OFF",
        "JSONV_BUILD_FUZZERS": "ON",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",     "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan",    "configurePreset": "asan" },
    { "name": "tidy",    "configurePreset": "tidy" },
    { "name": "fuzz",    "configurePreset": "fuzz", "targets": ["jsonv-fuzz-parse", "jsonv-fuzz-roundtrip"] }
  ],
  "testPresets": [
    { "name": "dev",     "configurePreset": "dev",     "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build",     "name": "dev" },
        { "type": "test",      "name": "dev" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build",     "name": "release" },
        { "type": "test",      "name": "release" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build",     "name": "asan" },
        { "type": "test",      "name": "asan" }
      ]
    },
    {
      "name": "fuzz",
      "steps": [
        { "type": "configure", "name": "fuzz" },
        { "type": "build",     "name": "fuzz" }
      ]
    }
  ]
}
